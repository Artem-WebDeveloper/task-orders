{
  "name": "task-orders",
  "version": "1.0.0",
  "description": "Task Orders Management System",
  "homepage": "https://github.com/Artem-WebDeveloper/task-orders#readme",
  "bugs": {
    "url": "https://github.com/Artem-WebDeveloper/task-orders/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Artem-WebDeveloper/task-orders.git"
  },
  "license": "MIT",
  "author": "Artem",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "lint": "npm run lint -w backend && npm run lint -w frontend",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .prettierignore"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6"
  }
}
